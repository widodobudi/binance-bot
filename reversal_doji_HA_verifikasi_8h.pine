//@version=5
indicator("Reversal Doji+HA Verifikasi (8h)", overlay=true)

// ============================================================
// VERIFIKASI STRATEGI REVERSAL — sinkron dgn bot live.
// Pola entry (urut kiri->kanan):
//   c-5..c-1 : 5 candle SEMUA merah (close<open) + penurunan total
//              (close c-1 / open c-5 - 1)*100 <= -5%   <-- BOT pakai -5% (bukan -3%)
//   c0       : doji (body < 20% range) DAN close c0 < EMA20 & < EMA50
//   c+1      : 1 candle Heikin Ashi bullish (konfirmasi)
//   c+2      : TITIK ENTRY, saat c+1 atau c+2 cross-up EMA20
//
// PENTING: pasang chart pakai CANDLESTICK BIASA (bukan Heikin Ashi).
// Script ini menghitung HA sendiri dari OHLC biasa; kalau chart sudah HA,
// hasilnya jadi double-HA & salah. Bot juga pakai OHLC candle biasa.
//
// PERUBAHAN vs versi lama (agar benar-benar mirror bot):
//   - TAMBAH filter choppy (body/range < 0.40 avg 10 candle -> SKIP), meniru is_choppy() bot.
//     Bot MENOLAK entry di pair choppy; tanpa ini Pine bisa "kelihatan ENTRY" padahal bot diam.
//   - trailDist() DIKALI TRAILING_FAKTOR (bot live = 1.10). Angka trailing kini cocok live.
//   - cross-up EMA20 disamakan tanda dgn bot: prev close < prev EMA & cur close >= cur EMA (pakai >=).
//
// LABEL diselaraskan dgn heartbeat bot: tiap syarat tampil NILAI AKTUAL + status ✅/❌.
// ============================================================

// ---------- Inputs ----------
emaFastLen  = input.int(20, "EMA Fast")
emaSlowLen  = input.int(50, "EMA Slow")
nRed        = input.int(5,  "Jumlah candle merah sebelum doji")
dropPct     = input.float(-5.0, "Min penurunan total (%)")
dojiBodyPct = input.float(20.0, "Maks body doji (% range)")
nHAconf     = input.int(1,  "Jumlah HA bull konfirmasi")
armPct      = input.float(2.0, "Trailing arm profit (%)", step=0.5)
trailFaktor = input.float(1.10, "Trailing FAKTOR (bot live = 1.10)", step=0.05)
entryManual = input.float(0.0, "Entry price manual (0=auto/off)", minval=0.0)
// Filter choppy (meniru is_choppy() bot)
choppyOn    = input.bool(true, "Filter choppy ON")
choppyMin   = input.float(0.40, "Min rata-rata body/range (choppy)", step=0.05)
choppyLook  = input.int(10, "Choppy lookback (candle)")
lblOffsetX  = input.int(2, "Geser label kanan (candle)", minval=0, maxval=100)
lblOffsetY  = input.float(0.0, "Geser label atas/bawah (% harga)", step=0.5)

ema20 = ta.ema(close, emaFastLen)
ema50 = ta.ema(close, emaSlowLen)
plot(ema20, "EMA20", color=color.orange, linewidth=1)
plot(ema50, "EMA50", color=color.red,    linewidth=1)

// ---------- Heikin Ashi (rumus standar, dihitung dari OHLC biasa) ----------
var float haClose = na
var float haOpen  = na
haClose := (open + high + low + close) / 4
haOpen  := na(haOpen[1]) ? (open + close) / 2 : (haOpen[1] + haClose[1]) / 2
haBull  = haClose > haOpen

// ---------- Helper: candle merah ----------
isRed(int i) => close[i] < open[i]

// ---------- Filter choppy: rata-rata body/range pd N candle TERTUTUP < ambang ----------
// Bot pakai candle tertutup; di sini pakai bar [1]..[choppyLook] agar tidak ikut bar berjalan.
bodyRatioBar(int i) =>
    r = high[i] - low[i]
    r > 0 ? math.abs(close[i] - open[i]) / r : 0.0
sumRatio = 0.0
for i = 1 to choppyLook
    sumRatio := sumRatio + bodyRatioBar(i)
avgBodyRatio = choppyLook > 0 ? sumRatio / choppyLook : 1.0
isChoppy = choppyOn and (bar_index >= choppyLook) and (avgBodyRatio < choppyMin)

// ---------- ATR% (live) & trailing deviation (tabel sama dgn bot, DIKALI FAKTOR) ----------
atrPct = ta.atr(14) / close * 100
trailDistBase(float a) => a < 1.0 ? 0.5 : a < 2.0 ? 1.0 : a < 4.0 ? 1.5 : a < 7.0 ? 2.0 : 2.5
trailDist(float a) => trailDistBase(a) * trailFaktor

// ============================================================
// EVALUASI: c0 (doji) di bar [2] supaya c+1=[1], c+2=[0] tersedia.
//   5 merah sebelum doji: bar [7]..[3]
//   penurunan total: close c-1 (=[3]) vs open c-5 (=[7])
// ============================================================
allRed = isRed(7) and isRed(6) and isRed(5) and isRed(4) and isRed(3)
nRedActual = (isRed(7)?1:0)+(isRed(6)?1:0)+(isRed(5)?1:0)+(isRed(4)?1:0)+(isRed(3)?1:0)
totalDrop = (close[3] / open[7] - 1) * 100
dropOk    = totalDrop <= dropPct
s1ok      = allRed and dropOk

range0   = high[2] - low[2]
body0    = math.abs(close[2] - open[2])
bodyRatio0 = range0 > 0 ? (body0 / range0) * 100 : 100
isDoji   = bodyRatio0 < dojiBodyPct
belowEma = close[2] < ema20[2] and close[2] < ema50[2]
c0ok     = isDoji and belowEma

c1ok = haBull[1]

// cross-up disamakan dgn bot _cross_up: prev close < prev EMA DAN cur close >= cur EMA
crossC1 = close[1] >= ema20[1] and close[2] < ema20[2]
crossC2 = close[0] >= ema20[0] and close[1] < ema20[1]
crossOk = crossC1 or crossC2

// entry sah hanya bila 4 syarat lolos DAN pair tidak choppy (spt bot)
entrySignal = s1ok and c0ok and c1ok and crossOk and not isChoppy

// ---------- Entry price & level +2% ----------
var float entryAuto = na
if entrySignal
    entryAuto := close
useManual  = entryManual > 0
entryPrice = useManual ? entryManual : entryAuto
armPrice   = na(entryPrice) ? na : entryPrice * (1 + armPct / 100)

var line armLine = na
if barstate.islast and not na(armPrice)
    line.delete(armLine)
    armLine := line.new(bar_index - 3, armPrice, bar_index + lblOffsetX, armPrice, xloc=xloc.bar_index, color=color.red, width=3)

plotshape(entrySignal, "REV ENTRY", shape.triangleup, location.belowbar, color.new(color.blue, 0), size=size.small, text="REV")

// ---------- Label status (diselaraskan dgn heartbeat bot + emoji ✅/❌) ----------
chk(bool b) => b ? "✅ lolos" : "❌ belum"
nPass = (s1ok?1:0)+(c0ok?1:0)+(c1ok?1:0)+(crossOk?1:0)

var label lb = na
label.delete(lb)
srcTxt = useManual ? "manual" : "auto"

txt  = "REVERSAL — lolos " + str.tostring(nPass) + "/4 (8h):\n"
txt := txt + "1 5 merah+turun>=" + str.tostring(-dropPct, "#.#") + "% (" + str.tostring(nRedActual, "#") + "/5 merah, turun " + str.tostring(totalDrop, "#.#") + "%) — " + chk(s1ok) + "\n"
txt := txt + "2 doji<" + str.tostring(dojiBodyPct, "#") + "%body & <EMA20/50 (body " + str.tostring(bodyRatio0/100, "#.##") + ") — " + chk(c0ok) + "\n"
txt := txt + "3 c+1 HA bullish — " + chk(c1ok) + "\n"
txt := txt + "4 cross-up EMA20 — " + chk(crossOk) + "\n"
txt := txt + "5 choppy body/range avg " + str.tostring(avgBodyRatio, "#.##") + " (min " + str.tostring(choppyMin, "#.##") + ") — " + (isChoppy ? "❌ CHOPPY (skip)" : "✅ ok") + "\n"
txt := txt + (entrySignal ? "-> ✅ ENTRY (LOLOS 4/4)" : (isChoppy ? "-> ❌ SKIP (choppy) — bot menolak" : "-> ❌ belum lolos"))
txt := txt + (na(entryPrice) ? "" : "\nentry(" + srcTxt + ") " + str.tostring(entryPrice, "#.######") + " | +" + str.tostring(armPct, "#.#") + "% @ " + str.tostring(armPrice, "#.######"))
gapPct = na(armPrice) ? na : (armPrice/close - 1)*100
txt := txt + (na(armPrice) ? "" : (close >= armPrice ? "\n+" + str.tostring(armPct, "#.#") + "% tercapai (trailing aktif)" : "\n+" + str.tostring(armPct, "#.#") + "% belum (kurang " + str.tostring(gapPct, "#.##") + "%)"))
txt := txt + "\nATR% live " + str.tostring(atrPct, "#.##") + " -> trailing " + str.tostring(trailDist(atrPct), "#.##") + "% (faktor " + str.tostring(trailFaktor, "#.##") + ")"

lblY = high * (1 + lblOffsetY / 100)
lb := label.new(bar_index + lblOffsetX, lblY, txt, xloc=xloc.bar_index, style=label.style_label_left, color=color.white, textcolor=color.black, size=size.normal)
