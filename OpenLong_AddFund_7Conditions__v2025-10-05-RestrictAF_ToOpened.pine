//@version=6
indicator("Open Long Deal & Add Fund with 7 Conditions", overlay=true, max_labels_count=500, max_lines_count=0)
// REMARK: Tag=BBxStochScanner • Version=v2025-10-05-AddFunds-RestrictToOpened • Notes=Add Funds & summary label kini hanya untuk simbol yang sudah tercatat Open Long; tersedia input manual fallback.

// ===== Base pairs (fixed 20) =====
string BASE20="BTCUSDT,ETHUSDT,BNBUSDT,ADAUSDT,SOLUSDT,DOTUSDT,AVAXUSDT,POLUSDT,TRXUSDT,ATOMUSDT,XLMUSDT,XRPUSDT,LTCUSDT,FILUSDT,ICPUSDT,NEARUSDT,ALGOUSDT,XTZUSDT,HBARUSDT,APTUSDT"

// ===== Inputs (umum) =====
addPairsText=input.string(title="Tambahan Pair (opsional, maks 10, pisah koma)", defval="", tooltip="20 fixed pairs: BTCUSDT, ETHUSDT, BNBUSDT, ADAUSDT, SOLUSDT, DOTUSDT, AVAXUSDT, POLUSDT, TRXUSDT, ATOMUSDT, XLMUSDT, XRPUSDT, LTCUSDT, FILUSDT, ICPUSDT, NEARUSDT, ALGOUSDT, XTZUSDT, HBARUSDT, APTUSDT")
showBarLabel=input.bool(title="Show Summary Label (per bar)?", defval=true)
keepBarsBack=input.int(title="Keep Summary Labels for last N bars", defval=2000, minval=1, maxval=100000)
dbgOn=input.bool(title="Debug Pair?", defval=true)
dbgPair=input.string(title="Debug Pair (contoh: AVAXUSDT)", defval="AVAXUSDT")
alertMode=input.string(title="Alert Mode", defval="Open Long Deal", options=["Open Long Deal","Add Funds (Quote)"])
addFundsVol=input.float(title="Add Funds Volume (quote, USDT)", defval=10.0, minval=0.0001, step=1)

// ===== Restrict Add Funds ke pasangan yang pernah Open Long =====
groupAF="Add Funds Guard"
restrictAF=input.bool(title="Batasi Add Funds hanya utk simbol yang sudah Open Long Deal?", defval=true, group=groupAF)
manualOpened=input.string(title="Tambahan daftar simbol yang SUDAH open (fallback, pisah koma)", defval="", group=groupAF, tooltip="Jika histori Open Long tidak terekam (mis. baru attach indikator), isi manual di sini. Contoh: BTCUSDT,ETHUSDT")

// ===== Kondisi #1 — Price vs BB =====
groupC1="Kondisi #1 — Price vs BB"
cond1Mode=input.string(title="Acuan Kondisi #1", defval="BB Lower", options=["BB Lower","BB Basis"], group=groupC1, tooltip="Pilih acuan Kondisi #1: BB Lower (close ≤ lower band) atau BB Basis (close ≤ basis).")

// ===== Kondisi #2 — KD Cross & Gap =====
groupC2="Kondisi #2 — KD Cross & Gap"
kdGapMin=input.float(title="%K minimal di atas %D (poin)", defval=2.0, step=0.1, minval=0.0, group=groupC2)

// ===== Kondisi #3 — %D Thresholds (ikut pilihan Kondisi #1) =====
groupC3="Kondisi #3 — %D"
dMaxLower=input.float(title="%D < jika acuan #1 = BB Lower", defval=20.0, step=1.0, minval=0.0, maxval=100.0, group=groupC3, tooltip="Ambang %D saat Kondisi #1 menggunakan BB Lower.")
dMaxBasis=input.float(title="%D < jika acuan #1 = BB Basis", defval=30.0, step=1.0, minval=0.0, maxval=100.0, group=groupC3, tooltip="Ambang %D saat Kondisi #1 menggunakan BB Basis.")

// ===== Kondisi #4 — UO Thresholds (ikut pilihan Kondisi #1) =====
groupC4="Kondisi #4 — UO"
uoMinLower=input.float(title="UO > jika acuan #1 = BB Lower", defval=40.0, step=1.0, group=groupC4, tooltip="Ambang UO saat Kondisi #1 menggunakan BB Lower.")
uoMinBasis=input.float(title="UO > jika acuan #1 = BB Basis", defval=50.0, step=1.0, group=groupC4, tooltip="Ambang UO saat Kondisi #1 menggunakan BB Basis.")

// ===== Toggle Kondisi =====
groupTog="Toggle Kondisi 5–7"
useCond5=input.bool(title="Gunakan Kondisi #5 (current price > Support)", defval=true, group=groupTog)
useCond6=input.bool(title="Gunakan Kondisi #6 (VolUSDT ≥ 1.5× MA20(VolUSDT) & Green Candle)", defval=false, group=groupTog)
useCond7=input.bool(title="Gunakan Kondisi #7 (Body Dominan, minimal wick)", defval=false, group=groupTog)

// ===== Tooltip (read-only) =====
const string _condTip=
 "1) Current price ≤ (BB Lower/Basis sesuai pilihan)\n"+
 "2) %K cross up di atas %D & gap ≥ kdGapMin\n"+
 "3) %D < ambang (lihat grup Kondisi #3)\n"+
 "4) UO > ambang (lihat grup Kondisi #4) — intrabar\n"+
 "5) current price > Support (pivot low strength=5)\n"+
 "6) VolUSDT ≥ 1.5× MA20(VolUSDT) & Green Candle\n"+
 "7) Body Dominan (≥60% range) & wick minimal (close ≤10% dari high)\n"+
 "➡️ Open Long: 1–5\n"+
 "➡️ Add Funds: (6 & 7 wajib) + 5 opsional"
string _infoTipAnchor=input.string(title="🛈 7 Kondisi Scanner (hover)", defval="", tooltip=_condTip, group="Help (read-only)")

// ===== Konstanta =====
int SWING_LOW_STRENGTH=5
string EXCH="BINANCE"
string TF=timeframe.period
int BB_LENGTH=20
string BB_MA="SMA"
float BB_MULT=2.0
int K_LEN=14, K_SMOOTH=1, D_SMOOTH=3
int MAX_PAIRS=30
int BOT_ID=16380123
string EMAIL_TOKEN="f97400b9-e9a4-4058-913e-35eb8372f920"

// ===== Helpers =====
_trim(s)=>str.replace_all(str.replace_all(s," ",""),"\n","")
_norm(s)=>str.upper(_trim(s))
_fmtPair(s)=>str.length(s)>4?str.substring(s,str.length(s)-4,str.length(s))+"_"+str.substring(s,0,str.length(s)-4):s
_ma(src,len,_type)=>_type=="SMA"?ta.sma(src,len):_type=="EMA"?ta.ema(src,len):_type=="SMMA (RMA)"?ta.rma(src,len):_type=="WMA"?ta.wma(src,len):ta.vwma(src,len)
_make_tkr(exch,pair)=>ticker.new(exch,pair)

// unik array
addUnique(arr,s)=>
    string t=_norm(s)
    if str.length(t)>0
        bool exists=false
        int n=array.size(arr)
        if n>0
            for i=0 to n-1
                if _norm(array.get(arr,i))==t
                    exists:=true
        if not exists
            array.push(arr,t)

inArray(arr,s)=>
    bool hit=false
    int n=array.size(arr)
    if n>0
        string t=_norm(s)
        for i=0 to n-1
            if _norm(array.get(arr,i))==t
                hit:=true
    hit

// pivot low terakhir (Support)
getCurrSupport(_low,_strength)=>
    pl=ta.pivotlow(_low,_strength,_strength)
    lastPl=ta.valuewhen(not na(pl),pl,0)
    na(lastPl)?na:lastPl

// ===== Core per symbol (1x security / simbol; SEBARIS) =====
checkSymbol(exch,pair,tf)=>
    string tkr=_make_tkr(exch,pair)
    [c,op,lo,hi,prevC,basis,lower,kRaw,dRaw,support,vol,uo]=request.security(tkr,tf,[close,open,low,high,close[1],_ma(close,BB_LENGTH,BB_MA),_ma(close,BB_LENGTH,BB_MA)-BB_MULT*ta.stdev(close,BB_LENGTH),ta.sma(ta.stoch(close,high,low,K_LEN),K_SMOOTH),ta.sma(ta.sma(ta.stoch(close,high,low,K_LEN),K_SMOOTH),D_SMOOTH),getCurrSupport(low,SWING_LOW_STRENGTH),volume,100.0*(4.0*(ta.sma(close-math.min(low,close[1]),7)/math.max(ta.sma(math.max(high,close[1])-math.min(low,close[1]),7),1e-10))+2.0*(ta.sma(close-math.min(low,close[1]),14)/math.max(ta.sma(math.max(high,close[1])-math.min(low,close[1]),14),1e-10))+(ta.sma(close-math.min(low,close[1]),28)/math.max(ta.sma(math.max(high,close[1])-math.min(low,close[1]),28),1e-10)))/7.0],barmerge.gaps_off,barmerge.lookahead_off)
    float k=kRaw, d=dRaw
    // Ambang dinamis berdasar cond1Mode
    float uoMinEff = cond1Mode=="BB Lower" ? uoMinLower : uoMinBasis
    float dMaxEff  = cond1Mode=="BB Lower" ? dMaxLower  : dMaxBasis
    // #1
    bool winCond1 = cond1Mode=="BB Lower" ? (c<=lower) : (c<=basis)
    // #2
    bool kupd=ta.crossover(k,d)
    bool gapOK=(k-d)>=kdGapMin
    bool winKD=ta.barssince(kupd and gapOK)==0
    // #3
    bool dLt=d<dMaxEff
    // #4
    bool winUO=uo>uoMinEff
    // #5: current price > Support (pivot low terakhir)
    bool cond5=not useCond5 or (not na(support) and c>support)
    // #6: VolUSDT ≥ 1.5× MA20(VolUSDT) & Green Candle
    float volUSDT=vol*c
    float maVolUSDT=ta.sma(volUSDT,20)
    bool cond6=not useCond6 or ((volUSDT>=maVolUSDT*1.5) and (c>op))
    // #7: Body Dominan, minimal wick
    float body=math.abs(c-op)
    float candleRange=hi-lo
    bool cond7=not useCond7 or ((candleRange>0?body/candleRange:0.0)>=0.6 and (c>op) and (c>hi-candleRange*0.1))
    // Open Long: 1–5 (dengan #1, #3, #4 memakai ambang dinamis)
    bool openLongOK=winCond1 and winKD and dLt and winUO and cond5
    // Add Funds: #6 & #7 wajib + #5 opsional (toggle)
    bool addFundsOK=cond6 and cond7 and cond5
    [openLongOK,addFundsOK,uo,c,lo,lower,k,d,winCond1,winKD,winUO,cond5,cond6,cond7,dMaxEff,uoMinEff,basis,support]

// ===== Alert JSON =====
sendAlert(pair,isAddFunds)=>
    string fp=_fmtPair(pair)
    if isAddFunds
        string msg='{"action":"add_funds_in_quote","message_type":"bot","bot_id":'+str.tostring(BOT_ID)+',"email_token":"'+EMAIL_TOKEN+'","delay_seconds":0,"pair":"'+fp+'","volume":'+str.tostring(addFundsVol)+'}'
        alert(msg)
    else
        string msg='{"message_type":"bot","bot_id":'+str.tostring(BOT_ID)+',"email_token":"'+EMAIL_TOKEN+'","delay_seconds":0,"pair":"'+fp+'"}'
        alert(msg)

// ===== Build pair list =====
string[] pairs=array.new_string()
for s in str.split(BASE20,",")
    addUnique(pairs,s)
string[] addArr=str.split(addPairsText,",")
for i=0 to math.min(array.size(addArr),10)-1
    addUnique(pairs,array.get(addArr,i))

// ===== State: daftar simbol yang pernah Open Long =====
var string[] openedPairs = array.new_string()

// merge manual fallback setiap bar (agar tetap ada walau historinya tidak terekam)
string[] _man = str.split(manualOpened,",")
for i=0 to array.size(_man)-1
    addUnique(openedPairs, array.get(_man,i))

// ===== Loop & debug =====
int sentThisBar=0
string triggeredList=""
var label[] dbgLbls=array.new<label>()
for i=0 to math.min(array.size(pairs),MAX_PAIRS)-1
    string p=array.get(pairs,i)
    // Panggil checkSymbol di setiap iterasi (konsisten, tidak kondisional)
    [okOpen,okAddFunds,uo,c,lo,lower,k,d,winCond1,winKD,winUO,cond5,cond6,cond7,dMaxEff,uoMinEff,basis,support]=checkSymbol(EXCH,p,TF)
    if str.length(p)>0
        // Rekam open long
        if okOpen
            addUnique(openedPairs, p)
            if alertMode=="Open Long Deal"
                sendAlert(p,false)
                sentThisBar+=1
                triggeredList := str.length(triggeredList)==0 ? _fmtPair(p) : triggeredList+", "+_fmtPair(p)

        // Guard Add Funds: harus termasuk openedPairs jika restrictAF=true
        bool allowAF = not restrictAF or inArray(openedPairs, p)
        if alertMode=="Add Funds (Quote)" and okAddFunds and allowAF
            sendAlert(p,true)
            sentThisBar+=1
            // Summary label khusus Add Funds: tampilkan hanya simbol yang qualify (allowAF)
            triggeredList := str.length(triggeredList)==0 ? _fmtPair(p) : triggeredList+", "+_fmtPair(p)

        // Debug label
        if dbgOn and str.upper(p)==_norm(dbgPair)
            while array.size(dbgLbls)>0
                label.delete(array.pop(dbgLbls))
            string dbgText="UO:"+str.tostring(uo,format.mintick)+" | #1 "+(winCond1?"✓":"✗")+" | #2(KD) "+(winKD?"✓":"✗")+" | #3(D<"+str.tostring(dMaxEff)+") "+((d<dMaxEff)?"✓":"✗")+" | #4(UO>"+str.tostring(uoMinEff)+") "+(winUO?"✓":"✗")+" | 5(Support):"+(cond5?"✓":"✗")+" 6:"+(cond6?"✓":"✗")+" 7:"+(cond7?"✓":"✗")
            label ldb=label.new(bar_index,close,text=dbgText,style=label.style_label_left,textcolor=color.black,color=color.new(color.green,0),size=size.small)
            array.push(dbgLbls,ldb)

// ===== Summary label =====
bool withinRange=time>=(timenow - keepBarsBack*timeframe.in_seconds()*1000)
if showBarLabel and withinRange and sentThisBar>0
    label.new(bar_index,close,text="TRIGGER: "+triggeredList,style=label.style_label_up,textcolor=color.white,color=color.new(color.green,0),size=size.normal)

// ===== Plot info =====
plot(sentThisBar,title="Jumlah alert terkirim (bar ini)",display=display.data_window)